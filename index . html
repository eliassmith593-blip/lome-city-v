<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>LOME CITY V</title><style>body{margin:0;overflow:hidden;background:#000;font-family:Arial Black}#hud{position:fixed;top:0;left:0;right:0;height:50px;background:rgba(0,0,0,0.9);display:flex;justify-content:space-between;align-items:center;padding:0 12px;color:#fff;z-index:99;font-size:11px}#money{color:#2eff7a;font-size:16px}#joy{position:fixed;bottom:80px;left:15px;width:100px;height:100px;background:rgba(255,255,255,0.08);border:2px solid #fff;border-radius:50%;z-index:99}#stick{position:absolute;left:25px;top:25px;width:50px;height:50px;background:#fff;border-radius:50%}.btn{position:fixed;bottom:20px;right:15px;padding:12px;background:#ffcc00;color:#000;font-weight:900;border:none;border-radius:10px;z-index:99}#speedo{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);color:#fff;font-size:22px;z-index:99;font-family:Impact}</style><script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script></head><body><div id="hud"><div><span id="money">$5240</span> | ELIAS SMITH</div><div style="color:#ffcc00">LOME CITY V</div><div id="mode">A PIED</div></div><div id="joy"><div id="stick"></div></div><button class="btn" id="btnE">E - VOITURE</button><div id="speedo"><span id="speed">0</span> KM/H</div><script>let scene=new THREE.Scene();scene.background=new THREE.Color(0x5a6a80);scene.fog=new THREE.Fog(0x5a6a80,30,140);let camera=new THREE.PerspectiveCamera(70,innerWidth/innerHeight,0.1,500);let renderer=new THREE.WebGLRenderer({antialias:true});renderer.setSize(innerWidth,innerHeight);document.body.appendChild(renderer.domElement);scene.add(new THREE.AmbientLight(0xffffff,0.7));let sun=new THREE.DirectionalLight(0xffffff,0.9);sun.position.set(80,100,30);scene.add(sun);let ground=new THREE.Mesh(new THREE.PlaneGeometry(600,600),new THREE.MeshStandardMaterial({color:0x252a33}));ground.rotation.x=-Math.PI/2;scene.add(ground);for(let i=-240;i<=240;i+=20){let r=new THREE.Mesh(new THREE.PlaneGeometry(12,600),new THREE.MeshStandardMaterial({color:0x111}));r.rotation.x=-Math.PI/2;r.position.set(i,0.01,0);scene.add(r);}for(let i=-240;i<=240;i+=20){let r=new THREE.Mesh(new THREE.PlaneGeometry(600,12),new THREE.MeshStandardMaterial({color:0x111}));r.rotation.x=-Math.PI/2;r.position.set(0,0.01,i);scene.add(r);}function tower(x,z,h,c){let m=new THREE.Mesh(new THREE.BoxGeometry(8,8,8),new THREE.MeshStandardMaterial({color:c}));m.position.set(x,h/2,z);scene.add(m);}for(let x=-180;x<180;x+=28){for(let z=-180;z<180;z+=28){if(Math.abs(x)<10||Math.abs(z)<10)continue;let h=6+Math.random()*18;tower(x,z,h,[0x6b4423,0x4a5568,0x2d3748][Math.floor(Math.random()*3)]);}}let player=new THREE.Group();let b=new THREE.Mesh(new THREE.CapsuleGeometry(0.32,1,4,8),new THREE.MeshStandardMaterial({color:0x2a4a2a}));b.position.y=0.95;player.add(b);player.position.set(-10,0,-25);scene.add(player);let car=new THREE.Group();let cb=new THREE.Mesh(new THREE.BoxGeometry(2.1,0.65,4.2),new THREE.MeshStandardMaterial({color:0xcc0000}));cb.position.y=0.55;car.add(cb);car.position.set(8,0,-25);scene.add(car);let mode='walk',yaw=Math.PI,keys={},joyX=0,joyY=0;addEventListener('keydown',e=>{keys[e.key.toLowerCase()]=1;if(e.key.toLowerCase()=='e')enterCar();});addEventListener('keyup',e=>keys[e.key.toLowerCase()]=0);let joy=document.getElementById('joy'),stick=document.getElementById('stick');function jm(e){let r=joy.getBoundingClientRect(),cx=r.left+50,cy=r.top+50,x=(e.touches[0].clientX-cx),y=(e.touches[0].clientY-cy),d=Math.hypot(x,y);let nx=x,ny=y;if(d>35){nx=x/d*35;ny=y/d*35}stick.style.left=25+nx+'px';stick.style.top=25+ny+'px';joyX=nx/35;joyY=ny/35}function jr(){stick.style.left='25px';stick.style.top='25px';joyX=0;joyY=0}joy.addEventListener('touchmove',jm);joy.addEventListener('touchend',jr);document.getElementById('btnE').onclick=enterCar;function enterCar(){let d=player.position.distanceTo(car.position);if(mode=='walk'&&d<4.5){mode='drive';player.visible=false;document.getElementById('mode').innerText='PORSCHE';}else{mode='walk';player.visible=true;player.position.copy(car.position);player.position.x+=3;}}function loop(){requestAnimationFrame(loop);let f=(keys['w']?1:0)-(keys['s']?1:0)-joyY;let t=(keys['a']?1:0)-(keys['d']?1:0)+joyX;yaw+=t*0.05;if(mode=='walk'){if(f){player.position.x-=Math.sin(yaw)*f*0.18;player.position.z-=Math.cos(yaw)*f*0.18;}player.rotation.y=yaw;camera.position.set(player.position.x+Math.sin(yaw)*4,2.5,player.position.z+Math.cos(yaw)*4);camera.lookAt(player.position);}else{if(f){car.position.x-=Math.sin(yaw)*f*0.35;car.position.z-=Math.cos(yaw)*f*0.35;}car.rotation.y=yaw;camera.position.set(car.position.x+Math.sin(yaw)*7,3,car.position.z+Math.cos(yaw)*7);camera.lookAt(car.position);document.getElementById('speed').innerText=Math.floor(Math.abs(f)*120)+' KM/H';}renderer.render(scene,camera);}loop();</script></body></html>
